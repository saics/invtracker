# Copy to .env (repo root) and fill in.

# Your SteamID64 (17 digits). Inventory must be public.
STEAM_ID=

# CSFloat API key: csfloat.com -> Profile -> Developers
CSFLOAT_API_KEY=

# Local SQLite file (default). For hosted use a Turso URL, e.g. libsql://xxx.turso.io
DATABASE_URL=file:data/invtracker.db
# Only needed for Turso
DATABASE_AUTH_TOKEN=

# Cron schedule for `pnpm prices:schedule` (default: every 6 hours)
PRICE_CRON=0 */6 * * *
