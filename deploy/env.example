# /opt/invtracker/.env on the server

STEAM_ID=
CSFLOAT_API_KEY=
PRICE_CRON=0 */2 * * *

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare R2 bucket for database backups (Litestream)
LITESTREAM_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
LITESTREAM_R2_BUCKET=invtracker-backup
LITESTREAM_R2_ACCESS_KEY_ID=
LITESTREAM_R2_SECRET_ACCESS_KEY=
